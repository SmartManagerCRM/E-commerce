# ---------------------------------------------------------------------------
# SmartManager E-commerce — environment variables
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (public — safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://yswvehtpwmzulgkvznnb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_irEgCI6U1hosmy90sCXFuw_5KWitIAY

# Supabase secret key (service role). SERVER ONLY. Bypasses RLS.
SUPABASE_SECRET_KEY=

# Platform hosts
#   production:  e-commerce.smartmanager.me  (console at app.e-commerce.smartmanager.me)
#   development: localhost                  (console at app.localhost:3000,
#                                            storefronts at <slug>.localhost:3000)
PLATFORM_ROOT_DOMAIN=e-commerce.smartmanager.me
CONSOLE_SUBDOMAIN=app
PUBLIC_URL_SCHEME=https
# PUBLIC_URL_PORT=3000

# What tenants point their custom domain at (shown in DNS instructions):
# the IP / hostname Hostinger gives for the Node.js app.
# STOREFRONT_DNS_TARGET=

# Email (Resend) — Phase 7. Without these, order/invitation emails and the
# daily brief are simply skipped (logged, never faked).
RESEND_API_KEY=
RESEND_FROM_EMAIL=SmartManager <no-reply@your-domain>

# Shared secret the notifications worker route requires. Set this, then point
# a Hostinger cron job / systemd timer at, e.g.,
#   curl -X POST https://<console-host>/api/jobs/daily-brief -H "Authorization: Bearer $JOBS_SECRET"
# hourly — the route itself is idempotent per tenant per local day.
JOBS_SECRET=
